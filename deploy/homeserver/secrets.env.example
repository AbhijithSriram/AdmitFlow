# Third-party keys for the homeserver deployment. Copy to /home/abhijith/.admitflow-secrets.env,
# fill in, then:  chmod 600 /home/abhijith/.admitflow-secrets.env
#
# install.sh reads this file and copies the backend keys into /etc/admitflow.env (root-only);
# the VITE_* ones are only used while building the website. Everything else (the Flask secret,
# the database password, the file-storage keys, the admin passwords) is generated by install.sh
# on the server and never written down anywhere else.
#
# This file is never committed. It can be deleted after a successful install: the values live
# on in /etc/admitflow.env. Do not quote values and do not use $substitution.

# Razorpay TEST-mode keys (rzp_test_...). Payments stay in the sandbox; no money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# Gmail app password for the account that sends OTP and confirmation emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Google reCAPTCHA v2 keys. The site must be registered for the hostname the app is served on
# (admitflow.abhijith-sriram.in), otherwise the checkbox shows "Invalid domain for site key" and
# nobody can sign up. With no secret set, signup is refused on a production server by design.
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=
