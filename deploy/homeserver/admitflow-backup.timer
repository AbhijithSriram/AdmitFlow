[Unit]
Description=Run the AdmitFlow backup every night

[Timer]
# 02:30 India time, a quiet hour for this site (the server's own clock is UTC, where 02:30 is 08:00 IST).
OnCalendar=*-*-* 02:30:00 Asia/Kolkata
RandomizedDelaySec=10min
# If the server was off at 02:30, run the missed backup at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
