# systemd unit for AdmitFlow's file storage (applicant photos, signatures, ID proofs and the
# application PDFs). Installed by deploy/homeserver/install.sh.
#
# Logs:  journalctl -u admitflow-minio -f
#
# Both ports are loopback-only: the API (127.0.0.1:9000) is reached by the app, and by browsers
# only through nginx for time-limited signed links. The console (127.0.0.1:9001) is not exposed.

[Unit]
Description=AdmitFlow file storage (MinIO)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abhijith
Group=abhijith

# MINIO_ROOT_USER and MINIO_ROOT_PASSWORD, generated by install.sh.
EnvironmentFile=/etc/admitflow-minio.env

# On the 596 GB /srv partition, not the 46 GB root file system: uploads are what grows.
ExecStart=/usr/local/bin/minio server /srv/nas/admitflow/minio \
    --address 127.0.0.1:9000 \
    --console-address 127.0.0.1:9001

Restart=always
RestartSec=3
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/nas/admitflow
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
